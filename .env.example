# COMMAND ADMIN — configure these in Vercel Environment Variables, never commit real values.
ADMIN_EMAIL=synovamedia@gmail.com
ADMIN_PASSWORD_HASH=scrypt$<salt-hex>$<derived-key-hex>
ADMIN_SESSION_SECRET=<long-random-secret>
GITHUB_TOKEN=<fine-grained-token-with-repository-content-and-actions-write-access>
VERCEL_TOKEN=<vercel-api-token>
VERCEL_PROJECT_ID=<vercel-project-id>
VERCEL_TEAM_ID=<vercel-team-id>
# Optional persistent audit storage via Vercel KV REST API.
AUDIT_KV_URL=<kv-rest-url>
AUDIT_KV_TOKEN=<kv-rest-token>

  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node suno-build.mjs",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {"source":"/command","destination":"/command/","permanent":false}
  ],
  "rewrites": [
    {"source":"/suno","destination":"/Suno/"},
    {"source":"/suno/","destination":"/Suno/"},
    {"source":"/command","destination":"/command/index.html"},
    {"source":"/command/","destination":"/command/index.html"},
    {"source":"/assets/mov/lv_0_20260718234757.mp4","destination":"/assets/mov/HERO_BG_WEBM.webm"},
    {"source":"/assets/2/LS1.png","destination":"/assets/2/LS3.png"},
    {"source":"/suno/v6","destination":"/Suno/library/README"},
    {"source":"/suno/prompting","destination":"/Suno/library/SUNO-V6-EVERYTHING-EXPANSION"},

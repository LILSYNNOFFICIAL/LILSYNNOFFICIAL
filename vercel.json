    {"source":"/suno/styles","destination":"/Suno/library/SUNO-V6-EVERYTHING-EXPANSION"},
    {"source":"/suno/audio","destination":"/Suno/library/SUNO-V6-EVERYTHING-EXPANSION"},
    {"source":"/suno/sliders","destination":"/Suno/library/SUNO-V6-EVERYTHING-EXPANSION"},
    {"source":"/suno/voices","destination":"/Suno/library/SUNO-V6-EVERYTHING-EXPANSION"},
    {"source":"/suno/editing","destination":"/Suno/library/SUNO-V6-EVERYTHING-EXPANSION"},
    {"source":"/suno/stems","destination":"/Suno/library/SUNO-V6-EVERYTHING-EXPANSION"},
    {"source":"/suno/studio","destination":"/Suno/library/SUNO-V6-EVERYTHING-EXPANSION"},
    {"source":"/suno/midi","destination":"/Suno/library/SUNO-V6-EVERYTHING-EXPANSION"},
    {"source":"/suno/effects","destination":"/Suno/library/SUNO-V6-EVERYTHING-EXPANSION"},
    {"source":"/suno/automation","destination":"/Suno/library/SUNO-V6-EVERYTHING-EXPANSION"},
    {"source":"/suno/production","destination":"/Suno/library/SUNO-V6-EVERYTHING-EXPANSION"},
    {"source":"/suno/troubleshooting","destination":"/Suno/library/SUNO-V6-EVERYTHING-EXPANSION"},
    {"source":"/suno/rights","destination":"/Suno/library/SUNO-V6-EVERYTHING-EXPANSION"},
    {"source":"/suno/complete","destination":"/Suno/complete/complete-guide"},
    {"source":"/suno/command-center","destination":"/Suno/command-center"},
    {"source":"/suno/prompt-architect","destination":"/Suno/prompt-architect"},
    {"source":"/suno/style-builder","destination":"/Suno/style-builder"},
    {"source":"/suno/lyrics-builder","destination":"/Suno/lyrics-builder"},
    {"source":"/suno/controls","destination":"/Suno/controls"},
    {"source":"/suno/troubleshooter","destination":"/Suno/troubleshooter"},
    {"source":"/suno/workflow","destination":"/Suno/workflow"},
    {"source":"/suno/customs/models","destination":"/Suno/customs/models"},
    {"source":"/suno/deep-dives/ultimate-control","destination":"/Suno/library/SUNO-V6-ULTIMATE-CONTROL-AND-PRODUCTION-ADDENDUM-2026"},
    {"source":"/suno/deep-dives/everything-expansion","destination":"/Suno/library/SUNO-V6-EVERYTHING-EXPANSION"},
    {"source":"/suno/deep-dives/final-current-expansion","destination":"/Suno/library/SUNO-V6-FINAL-CURRENT-EXPANSION"},

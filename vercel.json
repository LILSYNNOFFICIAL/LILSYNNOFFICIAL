{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node suno-build.mjs",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [{"source":"/command","destination":"/command/","permanent":false}],
  "rewrites": [
    {"source":"/suno","destination":"/Suno/home/"},
    {"source":"/suno/","destination":"/Suno/home/"},
    {"source":"/command/admin","destination":"/command/admin/index.html"},
    {"source":"/command/admin/","destination":"/command/admin/index.html"},
    {"source":"/command","destination":"/command/index.html"},
    {"source":"/command/","destination":"/command/index.html"},
    {"source":"/assets/mov/lv_0_20260718234757.mp4","destination":"/assets/mov/HERO_BG_WEBM.webm"},
    {"source":"/assets/2/LS1.png","destination":"/assets/2/LS3.png"},
    {"source":"/suno/deep-dives/ultimate-control","destination":"/Suno/library/SUNO-V6-ULTIMATE-CONTROL-AND-PRODUCTION-ADDENDUM-2026/"},
    {"source":"/suno/deep-dives/everything-expansion","destination":"/Suno/library/SUNO-V6-EVERYTHING-EXPANSION/"},
    {"source":"/suno/deep-dives/final-current-expansion","destination":"/Suno/library/SUNO-V6-FINAL-CURRENT-EXPANSION/"},
    {"source":"/suno/deep-dives/coverage-audit","destination":"/Suno/library/SUNO-V6-CURRENT-COVERAGE-AUDIT/"},
    {"source":"/suno/deep-dives/gaps-closure","destination":"/Suno/library/SUNO-V6-CURRENT-GAPS-CLOSURE/"},
    {"source":"/suno/deep-dives/gap-closure-all-remaining","destination":"/Suno/library/SUNO-V6-GAP-CLOSURE-ALL-REMAINING-CURRENT/"},
    {"source":"/suno/deep-dives/additional-current-details","destination":"/Suno/library/SUNO-V6-ADDITIONAL-CURRENT-DETAILS/"},
    {"source":"/suno/:path*","destination":"/Suno/:path*"}
  ],
  "headers": [
    {"source":"/assets/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/(.*\\.(?:js|css))","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]},
    {"source":"/(.*\\.html)","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]},
    {"source":"/command/admin/(.*)","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]},
    {"source":"/api/admin(.*)","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Referrer-Policy","value":"no-referrer"}]},
    {"source":"/","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]},
    {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]}
  ]
}